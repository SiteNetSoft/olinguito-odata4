<features xmlns="http://karaf.apache.org/xmlns/features/v1.0.0" name="olinguito-${project.version}">

  <feature name="olinguito-server" version="${project.version}" resolver="(obr)" start-level="50">
    <feature>war</feature>
    <bundle>mvn:org.slf4j/slf4j-api/${sl4j.version}</bundle>
    <bundle>mvn:org.codehaus.woodstox/stax2-api/${woodstox.stax2-api.version}</bundle>
    <bundle>mvn:com.fasterxml/aalto-xml/${aalto-xml.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.core/jackson-core/${jackson.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.core/jackson-annotations/${jackson.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.core/jackson-databind/${jackson.version}</bundle>

    <bundle>mvn:org.sitenetsoft.olinguito/odata-commons-api/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-commons-core/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-server-api/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-server-core/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-server-core-ext/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/server-adapter-servlet/${project.version}</bundle>
  </feature>

  <feature name="olinguito-client" version="${project.version}" resolver="(obr)" start-level="50">
    <bundle>mvn:org.slf4j/slf4j-api/${sl4j.version}</bundle>
    <bundle>mvn:org.codehaus.woodstox/stax2-api/${woodstox.stax2-api.version}</bundle>
    <bundle>mvn:com.fasterxml/aalto-xml/${aalto-xml.version}</bundle>
    <bundle>mvn:org.apache.httpcomponents.core5/httpcore5/${hc.core5.version}</bundle>
    <bundle>mvn:org.apache.httpcomponents.client5/httpclient5/${hc.client5.version}</bundle>

    <bundle>mvn:com.fasterxml.jackson.core/jackson-core/${jackson.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.core/jackson-annotations/${jackson.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.core/jackson-databind/${jackson.version}</bundle>
    <bundle>mvn:com.fasterxml.jackson.dataformat/jackson-dataformat-xml/${jackson.version}</bundle>

    <bundle>mvn:org.sitenetsoft.olinguito/odata-commons-api/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-commons-core/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-client-api/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-client-core/${project.version}</bundle>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-client-adapter-apache/${project.version}</bundle>
  </feature>

  <feature name="olinguito-server-netty" version="${project.version}" resolver="(obr)" start-level="50">
    <feature>olinguito-server</feature>
    <bundle>mvn:org.sitenetsoft.olinguito/server-adapter-netty/${project.version}</bundle>
  </feature>

  <feature name="olinguito-client-okhttp" version="${project.version}" resolver="(obr)" start-level="50">
    <feature>olinguito-client</feature>
    <bundle>mvn:org.sitenetsoft.olinguito/odata-client-adapter-okhttp/${project.version}</bundle>
  </feature>
</features>
