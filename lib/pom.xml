<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <artifactId>odata-lib</artifactId>
  <packaging>pom</packaging>
  <name>${project.artifactId}</name>

  <parent>
    <groupId>org.sitenetsoft.olinguito</groupId>
    <artifactId>odata-parent</artifactId>
    <version>5.0.1-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <modules>
    <module>commons-api</module>
    <module>commons-core</module>
    <module>client-api</module>
    <module>client-core</module>
    <module>odata-vocabularies</module>
    <module>server-api</module>
    <module>server-core</module>
    <module>server-core-ext</module>
    <module>test-fixtures</module>
    <module>server-adapter-servlet</module>
    <module>server-adapter-quarkus</module>
    <module>server-tecsvc</module>
    <module>server-test</module>
  </modules>

  <properties>
    <cobertura.skip>true</cobertura.skip>
    <!-- exclude proxy tests by default -->
    <exclude.regex>.*proxy.*</exclude.regex>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>build.fast</id>
      <properties>
        <pmd.skip>true</pmd.skip>
        <rat.skip>true</rat.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <exclude.regex>.*(proxy|client).*</exclude.regex>
      </properties>
    </profile>
    <profile>
      <id>build.quality</id>
      <properties>
        <cobertura.skip>false</cobertura.skip>
        <!-- nothing excluded -->
        <exclude.regex></exclude.regex>
      </properties>
    </profile>
    <!--
      Profile to exclude Quarkus extension from main build.
      The Quarkus extension has a chicken-and-egg problem where
      the deployment module needs the runtime module installed first.
      Build Quarkus separately: cd lib/server-adapter-quarkus && mvn install -Pbootstrap
      Then: mvn install -rf :server-adapter-quarkus-deployment
    -->
    <profile>
      <id>skip-quarkus</id>
      <modules>
        <module>commons-api</module>
        <module>commons-core</module>
        <module>client-api</module>
        <module>client-core</module>
        <module>odata-vocabularies</module>
        <module>server-api</module>
        <module>server-core</module>
        <module>server-core-ext</module>
        <module>test-fixtures</module>
        <module>server-adapter-servlet</module>
        <module>server-tecsvc</module>
        <module>server-test</module>
      </modules>
    </profile>
  </profiles>
</project>
